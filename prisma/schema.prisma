generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PartenaireType {
  institutionnels
  techniques
  financiers
}

enum CampagneType {
  principale
  intermediaire
}

enum CampagneStatut {
  active
  inactive
  cloturee
}

enum StatutPublication {
  brouillon
  publie
  archive
}

enum ContactStatut {
  nouveau
  lu
  traite
  archive
}

enum MediaType {
  image
  document
  video
}

enum AuditAction {
  create
  update
  delete
  login
  login_failed
  logout
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(100)
  label       String           @db.VarChar(150)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       Utilisateur[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(150)
  label       String           @db.VarChar(150)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int       @map("role_id")
  permissionId Int       @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model TableOrg {
  id         Int          @id @default(autoincrement())
  nom        String       @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  partenaires Partenaire[]

  @@map("table_org")
}

model Partenaire {
  id          Int            @id @default(autoincrement())
  nom         String         @db.VarChar(255)
  type        PartenaireType  @default(institutionnels)
  typeOrgId   Int?           @map("type_org")
  description String?        @db.Text
  logo        String?        @db.VarChar(255)
  contactName String?        @map("contact_name") @db.VarChar(255)
  contactEmail String?       @map("contact_email") @db.VarChar(255)
  contactPhone String?       @map("contact_phone") @db.VarChar(50)
  site        String?        @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  typeOrg     TableOrg?      @relation(fields: [typeOrgId], references: [id], onDelete: SetNull)

  @@index([typeOrgId])
  @@map("partenaires")
}

model RevuePresse {
  id              Int       @id @default(autoincrement())
  auteur          String    @db.VarChar(255)
  titre           String    @db.VarChar(255)
  description     String?   @db.Text
  imageCouverture String?   @map("image_couverture") @db.VarChar(255)
  datePub         DateTime? @map("date_pub") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("revue_presse")
}

model Agenda {
  id              Int               @id @default(autoincrement())
  titre           String            @db.VarChar(255)
  description     String?           @db.Text
  dateDeb         DateTime          @map("date_deb") @db.Date
  dateFin         DateTime?         @map("date_fin") @db.Date
  heureDeb        String?           @map("heure_deb") @db.VarChar(10)
  heureFin        String?           @map("heure_fin") @db.VarChar(10)
  ville           String?           @db.VarChar(255)
  adresse         String?           @map("addresse") @db.Text
  infosPratiques  String?           @map("infos_pratiques") @db.Text
  imageCouverture String?           @map("image_couverture") @db.VarChar(255)
  statut          StatutPublication @default(brouillon)
  datePub         DateTime?         @map("date_pub") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  images          AgendaImage[]
  documents       AgendaDocument[]

  @@index([statut])
  @@map("agenda")
}

model AgendaImage {
  id        Int      @id @default(autoincrement())
  agendaId  Int      @map("agenda_id")
  url       String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  agenda    Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)

  @@index([agendaId])
  @@map("agenda_images")
}

model AgendaDocument {
  id        Int      @id @default(autoincrement())
  agendaId  Int      @map("agenda_id")
  titre     String   @db.VarChar(255)
  url       String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  agenda    Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)

  @@index([agendaId])
  @@map("agenda_documents")
}

model ActeOia {
  id          Int       @id @default(autoincrement())
  titre       String    @db.VarChar(255)
  description String?   @db.Text
  pdfFile     String    @map("pdf_file") @db.VarChar(255)
  datePub     DateTime? @map("date_pub") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("actes_oia")
}

model Document {
  id          Int       @id @default(autoincrement())
  titre       String    @db.VarChar(255)
  description String?   @db.Text
  pdfFile     String    @map("pdf_file") @db.VarChar(255)
  datePub     DateTime? @map("date_pub") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("documents")
}

model PhotoAlbum {
  id          Int       @id @default(autoincrement())
  titre       String    @db.VarChar(255)
  description String?   @db.Text
  datePub     DateTime? @map("date_pub") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  photos      Photo[]

  @@map("photo_albums")
}

model Photo {
  id        Int        @id @default(autoincrement())
  albumId   Int?       @map("album_id")
  titre     String     @db.VarChar(255)
  photoFile String?    @map("photo_file") @db.Text
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  album     PhotoAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([albumId])
  @@map("photos")
}

model Video {
  id        Int       @id @default(autoincrement())
  auteur    String    @db.VarChar(255)
  titre     String    @db.VarChar(255)
  youtubeUrl String?  @map("youtube_url") @db.Text
  datePub   DateTime? @map("date_pub") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("videos")
}

model PressBook {
  id          Int              @id @default(autoincrement())
  titre       String           @db.VarChar(255)
  description String?          @db.Text
  datePub     DateTime?        @map("date_pub") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  photos      PressBookPhoto[]
  videos      PressBookVideo[]

  @@map("press_book")
}

model PressBookPhoto {
  id           Int       @id @default(autoincrement())
  pressBookId  Int       @map("press_book_id")
  titre        String    @db.VarChar(255)
  photoFile    String    @map("photo_file") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  pressBook    PressBook @relation(fields: [pressBookId], references: [id], onDelete: Cascade)

  @@index([pressBookId])
  @@map("press_book_photos")
}

model PressBookVideo {
  id           Int       @id @default(autoincrement())
  pressBookId  Int       @map("press_book_id")
  youtubeUrl   String    @map("youtube_url") @db.VarChar(255)
  titre        String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  pressBook    PressBook @relation(fields: [pressBookId], references: [id], onDelete: Cascade)

  @@index([pressBookId])
  @@map("press_book_videos")
}

model Campagne {
  id           Int             @id @default(autoincrement())
  nom          String          @db.VarChar(255)
  typeCampagne CampagneType    @default(principale) @map("type_campagne")
  dateDebut    DateTime        @map("date_debut") @db.Date
  dateFin      DateTime        @map("date_fin") @db.Date
  statut       CampagneStatut  @default(active)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  historiques  PrixTendanceHistorique[]

  @@map("campagnes")
}

model PrixTendance {
  id          Int                     @id @default(autoincrement())
  name        String                  @db.VarChar(255)
  description String?                 @db.Text
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  historiques PrixTendanceHistorique[]

  @@map("prix_tendance")
}

model PrixTendanceHistorique {
  id                    Int           @id @default(autoincrement())
  prixTendanceId        Int           @map("prix_tandance_id")
  campagneId            Int?          @map("campagne_id")
  prixNat               Decimal       @default(0) @map("prix_nat") @db.Decimal(15, 3)
  prixInter             Decimal       @default(0) @map("prix_inter") @db.Decimal(15, 3)
  pmgBordChamp          Decimal?      @map("pmg_bord_champ") @db.Decimal(15, 3)
  differentielRamassage Decimal?      @map("differentiel_ramassage") @db.Decimal(15, 3)
  forfaitTransport      Decimal?      @map("forfait_transport") @db.Decimal(15, 3)
  entreeUsine           Decimal?      @map("entree_usine") @db.Decimal(15, 3)
  locoMagasin           Decimal?      @map("loco_magasin") @db.Decimal(15, 3)
  fobGaranti            Decimal?      @map("fob_garanti") @db.Decimal(15, 3)
  cafGarantiEu          Decimal?      @map("caf_garanti_eu") @db.Decimal(15, 3)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  prixTendance          PrixTendance  @relation(fields: [prixTendanceId], references: [id], onDelete: Cascade)
  campagne              Campagne?     @relation(fields: [campagneId], references: [id], onDelete: SetNull)

  @@index([prixTendanceId])
  @@index([campagneId])
  @@map("prix_tendance_historiques")
}

model Projet {
  id              Int       @id @default(autoincrement())
  titre           String    @db.VarChar(255)
  description     String?   @db.Text
  dateDeb         DateTime? @map("date_deb") @db.Date
  dateFin         DateTime? @map("date_fin") @db.Date
  imageCouverture String?   @map("image_couverture") @db.VarChar(255)
  pdfFile         String?   @map("pdf_file") @db.VarChar(255)
  datePub         DateTime? @map("date_pub") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("projets")
}

model Utilisateur {
  id                  Int       @id @default(autoincrement())
  nom                 String    @db.VarChar(100)
  prenom              String    @db.VarChar(100)
  mail                String    @unique @db.VarChar(255)
  password            String    @db.VarChar(255)
  phone               String?   @db.VarChar(20)
  avatar              String?   @db.VarChar(255)
  roleId              Int?      @map("role_id")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  role                Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions            AuthSession[]
  media               Media[]
  auditLogs           AuditLog[]

  @@index([roleId])

  @@map("utilisateur")
}

model Categorie {
  id          Int         @id @default(autoincrement())
  nom         String      @unique @db.VarChar(150)
  slug        String      @unique @db.VarChar(170)
  description String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  actualites  Actualite[]

  @@map("categories")
}

model Actualite {
  id              Int               @id @default(autoincrement())
  titre           String            @db.VarChar(255)
  slug            String            @unique @db.VarChar(280)
  contenu         String            @db.Text
  extrait         String?           @db.Text
  auteur          String            @db.VarChar(255)
  categorieId     Int?              @map("categorie_id")
  imagePrincipale String?           @map("image_principale") @db.VarChar(500)
  statut          StatutPublication @default(brouillon)
  datePub         DateTime?         @map("date_pub") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  categorie       Categorie?        @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  @@index([categorieId])
  @@index([statut])
  @@map("actualites")
}

model ContactMessage {
  id        Int           @id @default(autoincrement())
  nom       String        @db.VarChar(255)
  email     String        @db.VarChar(255)
  telephone String?       @db.VarChar(50)
  sujet     String?       @db.VarChar(255)
  message   String        @db.Text
  statut    ContactStatut @default(nouveau)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([statut])
  @@map("contact_messages")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  cle       String   @unique @db.VarChar(150)
  valeur    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Media {
  id           Int          @id @default(autoincrement())
  type         MediaType
  url          String       @db.VarChar(500)
  publicId     String       @map("public_id") @db.VarChar(255)
  originalName String?      @map("original_name") @db.VarChar(255)
  mimeType     String?      @map("mime_type") @db.VarChar(150)
  size         Int?
  uploadedById Int?         @map("uploaded_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  uploadedBy   Utilisateur? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@map("media")
}

model AuditLog {
  id         Int          @id @default(autoincrement())
  userId     Int?         @map("user_id")
  action     AuditAction
  entity     String       @db.VarChar(100)
  entityId   String?      @map("entity_id") @db.VarChar(50)
  method     String       @db.VarChar(10)
  path       String       @db.VarChar(255)
  statusCode Int          @map("status_code")
  ipAddress  String?      @map("ip_address") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")
  user       Utilisateur? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
