# Neon PostgreSQL
# Pooled connection: used by the running app (Prisma Client queries)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Direct (unpooled) connection: required for Prisma Migrate
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

PORT=3000

# Public base URL of this API, used to build absolute URLs for locally stored uploads
APP_URL=https://backend-oiacafecacao.com

# Comma-separated list of origins allowed to call this API (CORS)
CORS_ORIGINS=https://backend-oiacafecacao.com,https://www.backend-oiacafecacao.com

# Session auth
AUTH_SESSION_TTL_DAYS=7
SEED_ACCESS_CONTROL=true

# Default super admin bootstrap (created on first boot if it does not exist yet)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NOM=Admin
DEFAULT_ADMIN_PRENOM=Super
DEFAULT_ADMIN_ROLE=super_admin

# Cloudinary (media storage for images and PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (used to email the contact form to CONTACT_RECIPIENT_EMAIL)
SMTP_HOST=mail.oia-cafecacao.ci
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@oia-cafecacao.ci
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=admin@oia-cafecacao.ci
